<?xml version="1.0"?>
<phpunit
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/9.6/phpunit.xsd"
	bootstrap="tests/bootstrap.php"
	colors="true"
>
	<testsuites>
		<testsuite name="b35 Instagram Archive Importer">
			<file>tests/Test_Instagram_Archive_Importer.php</file>
			<file>tests/Test_Instagram_Importer_Admin_Page.php</file>
		</testsuite>
	</testsuites>
	<coverage>
		<include>
			<directory>src/</directory>
		</include>
	</coverage>
</phpunit>
